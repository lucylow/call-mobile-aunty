{
  "name": "CALL-E Error Fallback — Resume Existing Run",
  "nodes": [
    {
      "parameters": {
        "content": "## CALL-E duplicate-run invariant\n\nIf a CALL-E run **may already exist**, resume and poll that run. Do **not** call Create / `run_call` again.\n\nThis workflow:\n1. Blocks DNC and missing consent\n2. Reuses `runId` / `callId` when present\n3. Creates **at most once** with an Idempotency-Key\n4. Treats create timeouts as in-flight (poll, never redial)\n5. Loops GET until a terminal status\n\nPhones must be synthetic `+1-202-555-xxxx` in tests. Keep the workflow **inactive** until credentials are reviewed.\n\nCALL-E recommends waiting ~60s before the first status poll; the Wait node is 8s for sandbox import testing.",
        "height": 460,
        "width": 380,
        "color": 5
      },
      "id": "note-safety",
      "name": "Import notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-420, -80]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calle-error-fallback",
        "responseMode": "lastNode"
      },
      "id": "trigger",
      "name": "Fallback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "calle-error-fallback"
    },
    {
      "parameters": {
        "jsCode": "const item=$json.body??$json; const contact=item.contact??{}; const phone=String(contact.phone??item.phone??''); return [{json:{requestId:String(item.requestId??item.idempotencyKey??$execution.id),source:String(item.source??'n8n'),intent:String(item.intent??'unknown'),contact:{name:String(contact.name??item.name??''),phone,externalId:contact.externalId},consent:String(item.consent??'unknown'),doNotContact:Boolean(item.doNotContact||item.onDnc),runId:item.runId??item.run_id??null,callId:item.callId??item.call_id??null,errorCode:item.errorCode??item.code??'',attempt:Number(item.attempt??0),maxAttempts:Number(item.maxAttempts??3),hasExistingRun:Boolean(item.runId||item.run_id||item.callId||item.call_id||item.hasExistingRun),survey:item.survey,context:item.context??{}}}];"
      },
      "id": "normalize",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const x=$json; const issues=[]; if(!x.contact?.phone)issues.push('MISSING_PHONE'); if(x.doNotContact)issues.push('CONTACT_IS_DNC'); if(x.consent!=='granted')issues.push('CALL_CONSENT_NOT_GRANTED'); return [{json:{...x,allowed:issues.length===0,policyIssues:issues}}];"
      },
      "id": "policy",
      "name": "Policy Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.allowed}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "if-allowed",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {blocked:true, reason:$json.policyIssues, requestId:$json.requestId, action:'BLOCK'} }}"
      },
      "id": "blocked",
      "name": "Blocked Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [960, 180]
    },
    {
      "parameters": {
        "jsCode": "function decideFallback(ctx){if(ctx.onDnc)return{allowed:false,action:'BLOCK',reason:'DNC policy'};if(!ctx.hasConsent)return{allowed:false,action:'BLOCK',reason:'missing consent'};if(ctx.code==='DUPLICATE_RUN'||ctx.hasExistingRun)return{allowed:true,action:'RESUME',reason:'resume existing run'};if(['NETWORK_TIMEOUT','PROVIDER_5XX','RATE_LIMITED','N8N_EXECUTION_TIMEOUT'].includes(ctx.code)&&ctx.attempt<ctx.maxAttempts)return{allowed:true,action:'RETRY',reason:'transient failure'};if(['NO_ANSWER','VOICEMAIL','CALL_BUSY'].includes(ctx.code))return{allowed:true,action:'ESCALATE',reason:'contact outcome requires policy-driven follow-up'};if(['SURVEY_PARSE_AMBIGUOUS','SURVEY_ABORTED'].includes(ctx.code))return{allowed:true,action:'ESCALATE',reason:'survey cannot be safely inferred'};if(['INVALID_PHONE','WEBHOOK_SIGNATURE','AUTH_INVALID','DNC_BLOCKED','CONSENT_MISSING'].includes(ctx.code))return{allowed:false,action:'BLOCK',reason:'safety or configuration failure'};return{allowed:false,action:'ESCALATE',reason:'unknown failure'};}\nfunction shouldCreateNewCall(ctx){const d=decideFallback(ctx);return d.allowed&&d.action==='RETRY'&&!ctx.hasExistingRun;}\nconst x=$json;\nconst ctx={code:String(x.errorCode??x.code??''),hasExistingRun:Boolean(x.runId||x.callId||x.hasExistingRun),hasConsent:x.consent==='granted',onDnc:Boolean(x.doNotContact),attempt:Number(x.attempt??0),maxAttempts:Number(x.maxAttempts??3)};\nconst decision=decideFallback(ctx);\nlet route='escalate';\nif(!ctx.hasConsent||ctx.onDnc||decision.action==='BLOCK')route='block';\nelse if(ctx.hasExistingRun||ctx.code==='DUPLICATE_RUN')route='resume';\nelse if(!ctx.code||shouldCreateNewCall(ctx))route='create';\nconst callePayload={to:x.contact.phone,contactName:x.contact.name,intent:x.intent,survey:x.survey,metadata:{requestId:x.requestId,source:x.source,resumeExisting:route==='resume'}};\nreturn [{json:{...x,...ctx,decision,route,createNewCall:route==='create',idempotencyKey:x.idempotencyKey??('call-e:'+x.requestId),callePayload,pollExisting:ctx.hasExistingRun||ctx.code==='N8N_EXECUTION_TIMEOUT'||ctx.code==='NETWORK_TIMEOUT'||ctx.code==='DUPLICATE_RUN'}}];"
      },
      "id": "decide",
      "name": "Decide Recovery",
      "type": "n8n-nodes-base.code",
